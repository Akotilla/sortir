{% extends 'base.html.twig' %}

{% block title %}
    Détail
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                {{ form_start(publicForm) }}
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"> {{ orga }}</h4>
                    </div>

                    <div class="card-body">

                        {% if userOrga.filename %}
                            <img src="{{ asset(user_images_public_path ~ '/' ~ userOrga.filename) }}"
                                 class="card-img-top img-fluid"
                                 alt="Image de {{ userOrga.pseudo }}"
                                 style="max-width: 150px; height: auto;">
                        {% endif %}

                        <div class="mb-3">
                            {{ form_row(publicForm.campus, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(publicForm.prenom, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(publicForm.nom, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(publicForm.telephone, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(publicForm.email, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        {{ form_end(publicForm) }}

                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}