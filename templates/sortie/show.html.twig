{% extends 'base.html.twig' %}

{% block title %}Détails de la sortie{% endblock %}

{% block body %}
    <div class="container mt-4">

        <h2 class="mb-4">{{ sortie.nom }}</h2>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card p-3 shadow-sm h-100">
                    <p><strong>Date et heure :</strong> {{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</p>
                    <p><strong>Date limite d'inscription :</strong> {{ sortie.dateLimiteInscription|date('d/m/Y H:i') }}
                    </p>
                    <p><strong>Nombre de places :</strong> {{ sortie.nbInscriptionMax }}</p>
                    <p><strong>Durée :</strong>
                        {% if sortie.duree is not null %}
                            {% set heures = (sortie.duree // 60) %}
                            {% set minutes = (sortie.duree % 60) %}
                            {{ heures }}h {{ minutes|format('%02d') }}min
                        {% endif %}
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card p-3 shadow-sm h-100">
                    <p><strong>Campus :</strong> {{ sortie.siteOrganisateur.nom }}</p>
                    {% if sortie.lieu %}
                        <p><strong>Ville :</strong> {{ sortie.lieu.ville.nom }}</p>
                        <p><strong>Rue :</strong> {{ sortie.lieu.rue }}</p>
                        <p><strong>Code postal :</strong> {{ sortie.lieu.ville.codePostal }}</p>
                        <p><strong>Lieu :</strong> {{ sortie.lieu.nom }}</p>
                        <p><strong>Latitude / Longitude :</strong> {{ sortie.lieu.latitude }}
                            / {{ sortie.lieu.longitude }}</p>
                    {% endif %}
                </div>

            </div>
        </div>

        <div class="card mt-4 p-3 shadow-sm">
            <h5>Description / Infos</h5>
            <p>{{ sortie.infosSortie }}</p>
        </div>

        <div class="card mt-4 p-3 shadow-sm">
            <h5>Participants inscrits ({{ sortie.participants|length }})</h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                    <tr>
                        <th>Pseudo</th>
                        <th>Nom</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for participant in sortie.participants %}
                        <tr>
                            <td>
                                <a href="{{ path('user_show', {'id': participant.id}) }}">
                                    {{ participant.pseudo }}
                                </a>
                            </td>
                            <td>{{ participant.nom }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2">Aucun participant inscrit</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
{% endblock %}