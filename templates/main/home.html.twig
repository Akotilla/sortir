{% extends 'base.html.twig' %}

{% block title %}
    Accueil
{% endblock %}


{% block body %}
    <h3 class="mb-4">Filtrer les sorties</h3>

    <form class="row g-4" method="POST" action="{{ path('main_filter') }}">

        <div class="col-md-6">
            <div class="card p-3 shadow-sm h-100">
                <div class="mb-3">
                    <label for="campus" class="form-label">Campus</label>
                    <select name="campus" id="campus" class="form-select">
                        <option value="">-- Sélectionnez un campus --</option>
                        {% for c in campus %}
                            <option value="{{ c.id }}" {% if c.id == selectedCampus %}selected{% endif %}>
                                {{ c.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label for="nom" class="form-label">Le nom de la sortie contient</label>
                    <input type="text" name="nomSortie" id="nom" class="form-control" value="{{ filters.nomSortie }}"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Date entre :</label>
                    <div class="d-flex gap-2">
                        <input type="date" name="dateDebut" id="date1" class="form-control"
                               value="{{ filters.dateDebut }}">
                        <input type="date" name="dateFin" id="date2" class="form-control"
                               value="{{ filters.dateFin }}">
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-6 d-flex flex-column">

            <div class="card p-3 shadow-sm flex-grow-1">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="sortieOrganisateur" id="sortie1" value="1" {% if filters.organisateur %}checked{% endif %}/>
                    <label class="form-check-label" for="sortie1">Sorties dont je suis l'organisateur/trice</label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="sortieInscrit" id="sortie2" value="1" {% if filters.inscrit %}checked{% endif %}/>
                    <label class="form-check-label" for="sortie2">Sorties auxquelles je suis inscrit/e</label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="sortiePasInscrit" id="sortie3" value="1" {% if filters.pasInscrit %}checked{% endif %}/>
                    <label class="form-check-label" for="sortie3">Sorties auxquelles je ne suis pas inscrit/e</label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="sortieTermine" id="sortie4" value="1" {% if filters.terminees %}checked{% endif %}/>
                    <label class="form-check-label" for="sortie4">Sorties terminées</label>
                </div>
            </div>


            <div class="text-center mt-3">
                <button class="btn btn-primary btn-lg px-5" type="submit">
                    Rechercher
                </button>
            </div>
        </div>

    </form>


    <table class="table">
        <thead>
        <tr>
            <th>Nom de la sortie</th>
            <th>Date de la sortie</th>
            <th>Clôture</th>
            <th>Inscrits/Places</th>
            <th>Etat</th>
            <th>Inscrit</th>
            <th>Organisateur</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for sortie in sorties %}
            {% if sortie is defined and sortie.etat is defined %}
                {% if sortie.etat.libelle != "Historisée" and
                    (sortie.etat.libelle != "En création" or app.user == sortie.organisePar) %}
                    <tr>
                        <td>{{ sortie.nom }}</td>
                        <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                        <td>{{ sortie.dateLimiteInscription|date('d/m/Y H:i') }}</td>
                        <td>{{ sortie.participants|length }}/{{ sortie.nbInscriptionMax }}</td>
                        <td>{{ sortie.etat.libelle }}</td>
                        <td>
                            {% if app.user in sortie.participants.toArray %}
                                Oui
                            {% else %}
                                Non
                            {% endif %}
                        </td>
                        <td>
                            {#                    <a href="{{ path('app_profil', {'id': sortie.organisePar.id}) }}"> #}
                            {{ sortie.organisePar.pseudo }}
                            {#                    </a> #}
                        </td>
                        <td>
                            {#                    <div class="btn-group" role="group"> #}
                            {#                        <a href="{{ path('sortie_show', {'id': sortie.id}) }}" class="btn btn-outline-info btn-sm">Voir</a> #}
                            {#                        {% if app.user == sortie.organisePar %} #}
                            {#                            <a href="{{ path('sortie_edit', {'id': sortie.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a> #}
                            {#                        {% endif %} #}
                            {#                        {% if sortie.dateLimiteInscription > "now" and sortie.participants|length < sortie.nbInscriptionMax %} #}
                            {#                            {% if app.user not in sortie.participants.toArray %} #}
                            {#                                <a href="{{ path('sortie_register', {'id': sortie.id}) }}" class="btn btn-outline-success btn-sm">S'inscrire</a> #}
                            {#                            {% else %} #}
                            {#                                <a href="{{ path('sortie_unregister', {'id': sortie.id}) }}" class="btn btn-outline-danger btn-sm">Se désister</a> #}
                            {#                            {% endif %} #}
                            {#                        {% endif %} #}
                            {#                    </div> #}
                        </td>
                    </tr>
                {% endif %}
            {% endif %}
        {% endfor %}
        </tbody>
    </table>


{% endblock %}


