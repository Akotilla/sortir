{% use 'form_div_layout.html.twig' %}


{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="card bg-danger text-white mb-3 p-2">
            {% for error in errors %}
                <strong>⚠ {{ error.message }}</strong><br>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
