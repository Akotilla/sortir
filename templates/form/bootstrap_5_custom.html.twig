{% use 'form_div_layout.html.twig' %}

{# =========================
   Bloc pour les erreurs
   ========================= #}
{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="card bg-danger text-white mb-3 p-2">
            {% for error in errors %}
                <strong>⚠ {{ error.message }}</strong><br>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{# =========================
   Bloc pour les champs simples (text, email, password)
   ========================= #}
{% block form_widget_simple %}
    {% set type = type|default('text') %}
    <input type="{{ type }}" {{ block('widget_attributes') }}
           class="form-control{{ (errors|length > 0 ? ' is-invalid' : '') }}"
           value="{{ value }}">
{% endblock %}

{# =========================
   Bloc pour checkbox / radio
   ========================= #}
{% block choice_widget_expanded %}
    <div class="form-check{{ errors|length > 0 ? ' is-invalid' : '' }}">
        {% for child in children %}
            <div class="form-check">
                {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(child, null, {'attr': {'class': 'form-check-label'}}) }}
            </div>
        {% endfor %}
    </div>
    {{ block('form_errors') }}
{% endblock %}

{# =========================
   Bloc pour textarea
   ========================= #}
{% block textarea_widget %}
    <textarea {{ block('widget_attributes') }}
              class="form-control{{ (errors|length > 0 ? ' is-invalid' : '') }}">{{ value }}</textarea>
{% endblock %}